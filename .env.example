# Search planner: OpenAI-compatible tool calling model, configured by the host.
SEARCH_MODEL_BASE_URL=https://api.deepseek.com/v1
SEARCH_MODEL=deepseek-chat
SEARCH_MODEL_API_KEY=
# Optional embeddings: enables Vane cosine ranking (>0.5) / deduplication (>0.75).
# With no embedding model, search uses SearXNG ordering and URL deduplication.
SEARCH_EMBEDDING_BASE_URL=https://api.openai.com/v1
SEARCH_EMBEDDING_MODEL=
SEARCH_EMBEDDING_API_KEY=
SEARXNG_URL=http://127.0.0.1:8080
SEARCH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8088,http://127.0.0.1:8088
# Shared service access token. Set this before exposing the gateway to a network.
SEARCH_GATEWAY_TOKEN=
# Required by docker-compose.search.yml. Generate a random secret before starting.
SEARXNG_SECRET=
